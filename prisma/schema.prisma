// Prisma schema — миграция MongoDB → PostgreSQL (strangler).
// PK = строка Mongo ObjectId (hex) на время миграции: см. docs/postgres-migration/MIGRATION-PLAN.md
// Модели добавляются ДОМЕН ЗА ДОМЕНОМ по мере переноса, начиная с Notification (пилот).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: URL-ы подключения вынесены в prisma.config.cjs (для Migrate CLI),
// а рантайм ходит через driver adapter (@prisma/adapter-pg) из v2/lib/prisma.js.
datasource db {
  provider = "postgresql"
}

// --- Домен 1 (пилот): Notification (v2 NotificationV2, коллекция notificationv2s) ---
// PK = строка Mongo ObjectId. recipientId пока без FK (TestUser ещё в Mongo —
// strangler). metadata.{link,entity} уплощены в колонки (это один вложенный
// объект, не массив). FK на users добавим при переносе домена identity.

enum NotificationType {
  NEW_ASSIGNMENT
  SUBMISSION_RECEIVED
  SUBMISSION_REVIEWED
  GROUP_INVITE
  NEW_GROUP_LESSON
  NEW_LESSON
  LESSON_REMINDER
  CONTRACT_APPROVED
  COACH_REQUEST
  COACH_REQUEST_DECIDED
  PAYMENT_SUCCESSFUL
  PAYMENT_FAILED
  COACH_APPLICATION
  COACH_APPLICATION_DECIDED
  NEW_MESSAGE
  SYSTEM_ANNOUNCEMENT
}

enum NotificationEntityType {
  Course
  Group
  Assignment
  User
}

model Notification {
  id                 String                  @id // Mongo ObjectId (hex)
  recipientId        String // → users.id (FK добавим в домене identity)
  message            String
  description        String?
  type               NotificationType
  read               Boolean                 @default(false)
  metadataLink       String?
  metadataEntityType NotificationEntityType?
  metadataEntityId   String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([recipientId, read])
  @@map("notifications")
}

// --- Домен 2: Payment (v2 Payment, коллекция payments) ---
// contractId/userId/clubId пока без FK (TrainingContract/User/Club ещё в Mongo).
// Два уникальных ограничения повторяют Mongo: один платёж на контракт + уникальный
// id транзакции шлюза (идемпотентность вебхука Stripe).

enum PaymentGateway {
  Stripe
  PayPal
  Manual
}

enum PaymentStatus {
  pending
  succeeded
  failed
}

model Payment {
  id                   String         @id // Mongo ObjectId (hex)
  clubId               String? // → clubs.id
  userId               String // → users.id
  contractId           String         @unique // один платёж на контракт
  amount               Int // в центах (min 0)
  currency             String // ISO-4217, uppercase (3)
  paymentGateway       PaymentGateway
  gatewayTransactionId String         @unique
  receiptUrl           String?
  status               PaymentStatus
  metadata             Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([userId])
  @@index([clubId])
  @@map("payments")
}

// --- Домен 3: Identity (v2 User == mongoose-модель 'TestUser', коллекция testusers) ---
// Канонические пользователи (решение Никиты: testusers → единая таблица users;
// legacy models/User как сущность НЕ переносим). PK = строка Mongo ObjectId.
// Нормализацию email→lowercase, телефон E.164, хеш пароля (bcrypt) и проверку
// пароля делает репозиторный шов user.repo.js (как раньше Mongoose pre-save/методы).
//
// roles — РЕАЛЬНЫЙ массив: есть фильтры find({roles:'ADMIN'}) и find({roles:role}).
// Рейтинги Glicko-2 по 4 контролям уплощены в 16 КОЛОНОК (не JSON): gameManager
// делает АТОМАРНЫЙ $set/$inc на ratings.{speed}.* после рейтинговой партии —
// колонки + Prisma increment сохраняют атомарность без гонки read-modify-write.
// Шов отдаёт их наружу в прежней форме { ratings: { bullet:{rating,rd,vol,games}, ... } }.

model User {
  id                  String   @id // Mongo ObjectId (hex)
  uuid                String   @unique @default(uuid())
  firebaseUID         String?  @unique // sparse: NULL в Postgres различны — несколько NULL допустимы
  firstName           String
  lastName            String
  avatarUrl           String?
  email               String   @unique // всегда lowercase (нормализует шов)
  phone               String? // E.164 (+380501234567), валидирует шов
  emailVerified       Boolean  @default(false)
  verificationToken   String?
  password            String // bcrypt-хеш
  roles               String[] @default(["USER"])
  sessionTokenVersion Int      @default(0) // ревокация сессий (accessToken.js)

  // Рейтинги онлайн-партий (Glicko-2, v2/utils/ratingCalculator.js) — по контролям
  bulletRating    Float @default(1500)
  bulletRd        Float @default(350)
  bulletVol       Float @default(0.06)
  bulletGames     Int   @default(0)
  blitzRating     Float @default(1500)
  blitzRd         Float @default(350)
  blitzVol        Float @default(0.06)
  blitzGames      Int   @default(0)
  rapidRating     Float @default(1500)
  rapidRd         Float @default(350)
  rapidVol        Float @default(0.06)
  rapidGames      Int   @default(0)
  classicalRating Float @default(1500)
  classicalRd     Float @default(350)
  classicalVol    Float @default(0.06)
  classicalGames  Int   @default(0)

  // Рейтинг решения задач (Elo, v2/utils/puzzleRatingCalculator.js) — Module 4
  puzzleRating      Float @default(1500)
  puzzleRatingGames Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationToken])
  @@index([lastName, firstName]) // список/сортировка студентов (chat, admin)
  @@map("users")
}

// --- Домен 4: Coaching (v2 Coach + TrainingContract) ---
// Coach — профиль тренера (1:1 к User). TrainingContract — запись ученика на курс.
// Кросс-модельные ссылки (userId/courseId/groupId/clubId) БЕЗ Prisma-связей: Course/
// Group/Club ещё в Mongo. Все джойны (user/course/group/payment) репозиторный шов
// делает на уровне ПРИЛОЖЕНИЯ (через userRepo/paymentRepo/Mongo-модели) — это снимает
// кросс-БД populate/$lookup и делает код storage-agnostic. PK = строка Mongo ObjectId.

enum ContractStatus {
  pending_payment
  pending_approval
  active
  completed
  cancelled
  refunded
}

model Coach {
  id     String  @id // Mongo ObjectId (hex)
  clubId String? // → clubs.id (Club в Mongo)
  userId String  @unique // → users.id (1:1)

  // Локализованный публичный профиль {en, uk?, pl?} — JSON (в БД не фильтруется).
  headline        Json? // LocalizedString
  bio             Json? // LocalizedString
  specializations Json? // LocalizedStringArray
  fideProfile     Json? // { fideId, title, rating:{standard,rapid,blitz}, profileUrl }

  isVerified Boolean @default(false)
  showOnSite Boolean @default(true) // показывать карточку на публичном сайте клуба

  // platformRating.average вынесен в КОЛОНКУ — по нему ORDER BY в каталоге тренеров.
  platformRatingAverage Float @default(0)
  platformRatingCount   Int   @default(0)

  payoutInfo Json? // { provider, accountId, status } — приватное, select('-payoutInfo')

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
  @@index([platformRatingAverage]) // сортировка каталога
  @@map("coaches")
}

model TrainingContract {
  id        String  @id // Mongo ObjectId (hex)
  clubId    String? // → clubs.id
  studentId String // → users.id
  courseId  String // → courses.id (Course в Mongo)
  coachId   String // → coaches.id
  groupId   String? // → groups.id (Group в Mongo)

  // Снимок цены на момент покупки (неизменяемый)
  priceAmount   Int // minor units
  priceCurrency String

  // Снимок пакета — JSON { description, individualLessonsTotal, groupLessonsTotal }
  packageSnapshot Json?

  status ContractStatus @default(pending_payment)

  // Прогресс (в БД не фильтруется/не сортируется — читается приложением)
  progressCompletedLessons      String[] @default([]) // массив ObjectId-строк
  progressLessonsCompletedCount Int      @default(0)
  progressPercentage            Int      @default(0)

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId]) // запрет дублей записи
  @@index([coachId, status])
  @@index([courseId, status])
  @@index([groupId])
  @@index([studentId])
  @@index([clubId])
  @@map("trainingcontracts")
}

// --- Домен 5: Content (Course, PuzzleBook, SiteSettings, Puzzle, Position) ---
// Клубный контент (Course/PuzzleBook/SiteSettings — мало строк) + справочная база задач
// (Puzzle ~150k, Position ~994k — read-mostly). Кросс-ссылки (clubId/authorIds/createdById/
// allowed*) БЕЗ Prisma-связей — Club/Coach(в PG)/Group/User джойнятся приложением через швы.
// Вложенные структуры (modules→lessons, exercises, auth/footer/socials/menu) — JSON.
// PK = строка Mongo ObjectId (у Puzzle/Position — исходный строковый _id: id задачи / FEN).

model Course {
  id          String  @id // Mongo ObjectId (hex)
  clubId      String? // → clubs.id (Club в Mongo)
  title       String
  description String
  thumbnailUrl String?

  authorIds      String[] @default([]) // → coaches.id (массив, app-join)
  isSchoolCourse Boolean  @default(false)

  modules Json? // [{ title, description, lessons:[{title,description,contentType,content,durationMinutes}] }]

  priceAmount   Int    @default(0) // minor units
  priceCurrency String @default("USD")

  status     String @default("draft") // draft|published|archived (легаси-флаг каталога)
  visibility String @default("draft") // draft|private|group|public

  allowedUserIds  String[] @default([]) // → users.id
  allowedGroupIds String[] @default([]) // → groups.id (Group в Mongo)
  isArchived      Boolean  @default(false)

  level    String? // beginner|intermediate|advanced|expert
  tags     String[] @default([])
  language String   @default("en") // en|uk|pl

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
  @@index([visibility, isArchived])
  @@map("courses")
}

model PuzzleBook {
  id          String  @id // Mongo ObjectId (hex)
  clubId      String? // → clubs.id
  title       String
  description String  @default("")
  createdById String // → users.id

  solveSettings Json? // { hintsEnabled, hintUnlockMinutes, hintUnlockMistakes, allowShowSolution, showPlayerNames }

  status     String @default("draft") // draft|published
  visibility String @default("draft") // draft|private|group|public

  allowedUserIds  String[] @default([])
  allowedGroupIds String[] @default([])
  isArchived      Boolean  @default(false)

  sourceTaskId          String?  @unique // не больше одного задачника на задачу оцифровщика (sparse)
  sourceImportedChapters String[] @default([])

  exercises Json? // [{ _id, number, title, fen, comment, hint, solution, chapter, rating, ratingAttempts, meta }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
  @@index([visibility, isArchived])
  @@map("puzzlebooks")
}

model SiteSettings {
  id       String  @id // Mongo ObjectId (hex)
  clubId   String  @unique // → clubs.id (одна запись на клуб)
  siteName String?
  logoUrl  String?
  tagline  String?

  auth    Json? // { promoTitle, promoSubtitle, backgroundUrl, buttonColor, facts:[{value,label}] }
  footer  Json? // { text, legalName, links:[{label,url}] }
  socials Json? // { facebook, instagram, twitter, youtube, telegram }
  menu    Json? // [{ key, label, path, hidden, order }]
  theme   Json? // { mode: 'light'|'dark' } — тема публичного сайта клуба (выбирает владелец)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sitesettings")
}

// База задач. У Lichess-задач source=null (moves[0] — ход соперника); у книжных — source.kind='book'.
model Puzzle {
  id         String   @id // исходный строковый _id задачи (Lichess id или ObjectId книги)
  fen        String
  moves      String[] @default([])
  rating     Int
  themes     String[] @default([])
  popularity Int?
  nbPlays    Int?

  // source уплощён в колонки (по ним идут фильтры каталога книжных задач).
  sourceKind           String? // 'book' | null
  sourceBook           String? // → puzzlebooks.id
  sourceBookTitle      String?
  sourceExercise       String? // PuzzleBook.exercises._id
  sourceExerciseNumber Int?
  sourceTitle          String?
  sourceSideToMove     String? // 'w' | 'b'
  sourceSolutionSan    String[] @default([])
  sourcePublished      Boolean? // ученикам видны только задачи опубликованных книг

  @@index([rating])
  @@index([sourceKind, sourcePublished, rating])
  @@index([sourceBook])
  // GIN по themes[] — фильтры задач по теме (survival/rush, getRandom theme) на 6М строк.
  @@index([themes(ops: ArrayOps)], type: Gin, map: "puzzles_themes_gin")
  @@map("puzzles")
}

// Дебютная/справочная статистика позиций: id = FEN, m = ходы со статистикой партий.
model Position {
  id String @id // FEN-строка
  t  Int? // всего партий
  m  Json? // [{ s:SAN, g:games, w:white, d:draw, l:loss }]

  @@map("positions")
}

// Прогресс ученика по курсу-конструктору (Фаза A5): одна строка = один пройденный блок.
// Новая фича — только PG (mongo-прошлого нет). Кросс-ссылки без Prisma-связей (app-join через швы).
model CourseProgress {
  id          String   @id // ObjectId-строка (как и прочие PK миграции)
  courseId    String // → courses.id
  studentId   String // → users.id
  blockId     String // CourseBlock.id внутри course.modules
  chapterId   String? // CourseChapter.id (для группировки/аналитики)
  completedAt DateTime @default(now())

  @@unique([courseId, studentId, blockId]) // идемпотентность отметки
  @@index([courseId, studentId])
  @@index([courseId])
  @@map("course_progress")
}

// --- Домен 6: Learning (Assignment, Submission, PuzzleAttempt, ScheduleV2) ---
// Домашки/сдачи/попытки/расписание. Кросс-ссылки (clubId/authorId=Coach/studentId=User/
// scheduleId/puzzleBookId/coachId/contractId/contextRefId) БЕЗ Prisma-связей — джойнятся
// приложением через швы. Вложенное (plan, context, review) — колонки/Json. PK=ObjectId-строка.
// Коллекции в Mongo: assignments, submissions, puzzleattempts, schedulev2 (v2; legacy `schedules` НЕ трогаем).

enum AssignmentContextType {
  student
  group
  course
}

enum AssignmentKind {
  generic
  puzzles
}

enum SubmissionStatus {
  submitted
  needs_revision
  approved
}

enum ScheduleContextType {
  individual
  group
  course_wide
}

enum ScheduleStatus {
  scheduled
  completed
  cancelled
  missed
}

model Assignment {
  id          String  @id // Mongo ObjectId (hex)
  clubId      String? // → clubs.id
  title       String
  description String?
  authorId    String // → coaches.id

  contextType  AssignmentContextType
  contextRefId String // userId | groupId | courseId (по contextType)

  lessonId   String? // урок в курсе (Course.modules.lessons._id)
  scheduleId String? @unique // → schedulev2.id (не больше одного ДЗ на занятие, sparse)

  dueDate DateTime?

  kind         AssignmentKind @default(generic)
  puzzleBookId String? // → puzzlebooks.id (для kind=puzzles)
  puzzleTarget Int            @default(0)
  plan         Json? // [{ date, puzzleCount, note }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, createdAt])
  @@index([contextType, contextRefId])
  @@map("assignments")
}

model Submission {
  id           String  @id // Mongo ObjectId (hex)
  clubId       String? // → clubs.id
  assignmentId String // → assignments.id
  studentId    String // → users.id

  contentText    String?
  contentFileUrl String?

  // Вложение (скриншот). data тянется только по отдельному запросу (как select:false в Mongo).
  attachmentData        Bytes?
  attachmentContentType String?
  attachmentSize        Int?
  attachmentFilename    String?

  submittedAt DateTime @default(now())

  status SubmissionStatus @default(submitted)

  reviewComment    String?
  reviewReviewedBy String? // → coaches.id
  reviewReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentId]) // одна сдача ДЗ на студента
  @@index([studentId, status])
  @@map("submissions")
}

model PuzzleAttempt {
  id               String  @id // Mongo ObjectId (hex)
  studentId        String // → users.id
  puzzleBookId     String // → puzzlebooks.id
  exerciseId       String // _id упражнения внутри книги
  solved           Boolean @default(true)
  timeTakenSeconds Int     @default(0)
  attemptsCount    Int     @default(0)
  usedHint         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([puzzleBookId, studentId])
  @@index([studentId])
  @@map("puzzleattempts")
}

// --- Волна «tenant/coaching-остатки» (Club, ClubMembership, Group, Player, CoachApplication,
//     CoachRequest) — ЕДИНЫЙ флаг TENANT_DB=mongo|pg (отдельный, т.к. USER_DB/COACHING_DB уже pg).
//     Кросс-ссылки (ownerId/userId/coachId/clubId/memberIds/children/enrollmentId) — app-join через швы.
//     Вложенное (limits/billing/botConfig/ratings/fideProfile) — колонки/Json. PK=ObjectId-строка.

enum ClubPlan {
  start
  club
  academy
}

enum ClubStatus {
  active
  suspended
}

enum MembershipRole {
  owner
  trainer
  student
  parent
}

enum MembershipStatus {
  active
  invited
  removed
}

enum GroupStatus {
  active
  archived
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

model Club {
  id      String     @id // Mongo ObjectId (hex)
  name    String
  slug    String     @unique
  city    String?
  logoUrl String?
  brandPrimaryColor String @default("#2B50E0")
  ownerId String // → users.id
  plan    ClubPlan   @default(start)
  status  ClubStatus @default(active)

  // Лимиты тарифа (null = без лимита у academy)
  limitsMaxStudents   Int?
  limitsMaxTrainers   Int?
  limitsMaxLessonSize Int?

  // Биллинг Stripe
  billingStripeCustomerId     String?
  billingStripeSubscriptionId String?
  billingCurrentPeriodEnd     DateTime?

  botConfig Json? // { telegram:{enabled}, whatsapp:{enabled} }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("clubs")
}

model ClubMembership {
  id          String           @id // Mongo ObjectId (hex)
  clubId      String // → clubs.id
  userId      String // → users.id
  role        MembershipRole
  status      MembershipStatus @default(active)
  childrenIds String[]         @default([]) // → users.id (дети для parent)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, userId])
  @@index([userId, status])
  @@index([clubId, role, status])
  @@map("clubmemberships")
}

model Group {
  id          String      @id // Mongo ObjectId (hex)
  clubId      String? // → clubs.id
  name        String
  description String?
  coachId     String // → coaches.id
  memberIds   String[]    @default([]) // → users.id
  status      GroupStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId])
  @@map("groups")
}

// v2 модель 'PlayerV2' (рейтинги быстрых партий, отдельно от User.ratings Glicko-2).
model PlayerV2 {
  id     String @id // Mongo ObjectId (hex)
  userId String @unique // → users.id

  ratings        Json? // { bullet:{rating,gamesPlayed}, blitz:{...}, rapid:{...}, classic:{...} }
  statsTotalWins Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("playerv2s")
}

model CoachApplication {
  id              String            @id // Mongo ObjectId (hex)
  clubId          String? // → clubs.id
  applicantId     String // → users.id
  headline        String            @default("")
  motivation      String
  experience      String            @default("")
  specializations String[]          @default([])
  contact         String            @default("")
  fideProfile     Json? // { fideId, title, rating:{standard,rapid,blitz}, profileUrl }
  sourceLang      String            @default("en")
  status          ApplicationStatus @default(pending)
  adminNote       String            @default("")
  decidedAt       DateTime?
  decidedById     String? // → users.id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([applicantId])
  @@map("coachapplications")
}

model CoachRequest {
  id           String            @id // Mongo ObjectId (hex)
  clubId       String? // → clubs.id
  studentId    String // → users.id
  coachId      String // → coaches.id
  experience   String // Beginner|Intermediate|Advanced
  goals        String            @default("")
  status       ApplicationStatus @default(pending)
  decidedAt    DateTime?
  enrollmentId String? // → trainingcontracts.id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId, status, createdAt])
  @@index([studentId, coachId])
  @@map("coachrequests")
}

// Расписание занятий (v2 модель 'ScheduleV2', коллекция schedulev2).
model ScheduleV2 {
  id              String         @id // Mongo ObjectId (hex)
  clubId          String? // → clubs.id
  title           String
  description     String         @default("")
  date            DateTime
  durationMinutes Int?
  link            String         @default("")
  status          ScheduleStatus @default(scheduled)
  coachId         String // → coaches.id

  contextType  ScheduleContextType
  contextRefId String // userId | groupId | courseId (по contextType)

  contractId String? // → trainingcontracts.id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId, date])
  @@index([contextRefId, date])
  @@map("schedulev2")
}

// --- Волна «realtime+misc» (ЗАВЕРШЕНИЕ миграции). Флаги: PLAY_DB (Game/LiveGame/ClassroomSession —
//     горячие, сокеты/Redis) и MISC_DB (чат/медиа/sitepage/savedgame — сейчас пусты). PK=ObjectId-строка
//     (Game id=ObjectId). Кросс-ссылки app-join через швы; вложенное (timeControl/clock/ratings/
//     attendance/annotations/variants/blocks/context/lastMessage) — колонки/Json.

enum LiveGameStatus {
  created
  active
  finished
  aborted
}

enum LiveGameSource {
  challenge
  lobby
  pairing
  rematch
}

enum CreatorColor {
  white
  black
  random
}

enum TimeControlKind {
  bullet
  blitz
  rapid
  classical
}

enum ClassroomStatus {
  live
  ended
}

enum SavedGameContext {
  personal_training
  group_study
}

enum ChatContextKind {
  direct
  puzzle
  homework
  book
}

enum ConversationType {
  private
  group
}

enum MediaKind {
  image
}

enum MediaStorage {
  mongo
  s3
}

enum SitePageStatus {
  draft
  published
}

// Архив партий (справочный, ~16900). white/black — строки (имена), не рефы.
model Game {
  id     String  @id
  white  String?
  black  String?
  result String?
  eco    String?
  an     String?

  @@index([white])
  @@index([black])
  @@map("games")
}

model LiveGame {
  id            String        @id
  whitePlayerId String?
  blackPlayerId String?
  createdById   String
  creatorColor  CreatorColor  @default(random)
  source        LiveGameSource @default(challenge)
  isPrivate     Boolean       @default(true)
  isRated       Boolean       @default(true)

  timeControlKind            TimeControlKind
  timeControlInitialSeconds  Int
  timeControlIncrementSeconds Int
  timeControlCustom          Boolean @default(false)

  fen      String
  moves    String[] @default([])
  sanMoves String[] @default([])
  pgn      String   @default("")

  status    LiveGameStatus @default(created)
  winner    String? // white|black|draw|null
  endReason String?

  clockWhiteMs    Int?
  clockBlackMs    Int?
  clockTurnStartedAt DateTime?

  drawOfferBy String? // white|black|null

  ratingChangesWhite Int?
  ratingChangesBlack Int?
  ratingsWhite Json? // { before, after, diff, provisional }
  ratingsBlack Json?
  ratingRange  Int?
  rematchOfId  String?

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([whitePlayerId, createdAt])
  @@index([blackPlayerId, createdAt])
  @@index([status, isPrivate, createdAt])
  @@map("livegames")
}

model ClassroomSession {
  id         String          @id
  clubId     String?
  groupId    String?
  studentId  String?
  coachId    String
  scheduleId String?
  status     ClassroomStatus @default(live)
  startedAt  DateTime        @default(now())
  endedAt    DateTime?
  attendance Json? // [{ user, role, joinedAt, lastSeenAt, leftAt }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, startedAt])
  @@map("classroomsessions")
}

model SavedGame {
  id             String           @id
  clubId         String?
  pgn            String
  title          String           @default("Анализ партии")
  description    String?
  annotations    Json? // [{ moveIdentifier, comment, arrows, squares, author }]
  contextType    SavedGameContext
  contextRefId   String
  lastUpdatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("savedgames")
}

model ChatRoom {
  id            String          @id
  memberIds     String[]        @default([]) // ровно 2 разных
  key           String          @unique
  contextKind   ChatContextKind @default(direct)
  contextRefId  String?
  contextTitle  String?
  lastMessageText      String?
  lastMessageSenderId  String?
  lastMessageCreatedAt DateTime?
  lastMessageAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastMessageAt])
  @@map("chat_rooms")
}

model ChatMessage {
  id       String    @id
  roomId   String
  senderId String
  text     String
  readAt   DateTime?
  clientId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, createdAt])
  @@index([roomId, readAt, senderId])
  @@map("chat_messages")
}

model ConversationV2 {
  id             String           @id
  type           ConversationType
  memberIds      String[]         @default([])
  groupContextId String?
  lastMessageText      String?
  lastMessageSenderId  String?
  lastMessageTimestamp DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conversations")
}

model MessageV2 {
  id             String @id
  conversationId String
  senderId       String
  text           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@map("messages")
}

model MediaAsset {
  id           String       @id
  clubId       String
  kind         MediaKind    @default(image)
  mimeType     String?
  originalName String?
  originalMime String?
  alt          String       @default("")
  width        Int          @default(0)
  height       Int          @default(0)
  size         Int          @default(0)
  storage      MediaStorage @default(mongo)
  variants     Json? // { thumb, medium, large }
  url          String?
  uploadedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId, createdAt])
  @@map("mediaassets")
}

model MediaBlob {
  id          String @id
  key         String @unique
  clubId      String
  contentType String?
  data        Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mediablobs")
}

// Заявка на пробное занятие с публичного сайта клуба (debiut, этап Leads).
model Lead {
  id            String     @id // Mongo ObjectId (hex)
  clubId        String
  source        String     @default("site") // site | manual
  pagePath      String?
  who           String     @default("self") // self | child
  name          String
  childAge      Int?
  email         String?
  phone         String?
  level         String? // new | rules | tournaments
  format        String? // offline | online
  preferredTime String?
  coachId       String? // Coach.id (если пришли с профиля тренера)
  groupId       String?
  status        LeadStatus @default(new)
  lostReason    String?
  assigneeId    String?
  note          String?
  consentAt     DateTime?
  consentIp     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([clubId, status, createdAt])
  @@map("leads")
}

enum LeadStatus {
  new
  contacted
  trial_scheduled
  trial_done
  converted
  lost
}

model SitePage {
  id          String         @id
  clubId      String
  slug        String
  // Опубликованный снимок (виден посетителям). Правка черновика его не трогает.
  title       String         @default("")
  blocks      Json? // [{ id, type, props }]
  status      SitePageStatus @default(draft)
  version     Int            @default(1)
  // Черновик — редактируемая копия, отдельно от опубликованного снимка. publish копирует draft* → поля выше.
  draftTitle   String?
  draftBlocks  Json?
  draftVersion Int?
  hasDraft     Boolean @default(false)
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, slug])
  @@map("sitepages")
}

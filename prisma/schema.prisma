// Prisma schema — миграция MongoDB → PostgreSQL (strangler).
// PK = строка Mongo ObjectId (hex) на время миграции: см. docs/postgres-migration/MIGRATION-PLAN.md
// Модели добавляются ДОМЕН ЗА ДОМЕНОМ по мере переноса, начиная с Notification (пилот).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// --- Домен 1 (пилот): Notification (v2 NotificationV2, коллекция notificationv2s) ---
// PK = строка Mongo ObjectId. recipientId пока без FK (TestUser ещё в Mongo —
// strangler). metadata.{link,entity} уплощены в колонки (это один вложенный
// объект, не массив). FK на users добавим при переносе домена identity.

enum NotificationType {
  NEW_ASSIGNMENT
  SUBMISSION_RECEIVED
  SUBMISSION_REVIEWED
  GROUP_INVITE
  NEW_GROUP_LESSON
  NEW_LESSON
  LESSON_REMINDER
  CONTRACT_APPROVED
  COACH_REQUEST
  COACH_REQUEST_DECIDED
  PAYMENT_SUCCESSFUL
  PAYMENT_FAILED
  COACH_APPLICATION
  COACH_APPLICATION_DECIDED
  NEW_MESSAGE
  SYSTEM_ANNOUNCEMENT
}

enum NotificationEntityType {
  Course
  Group
  Assignment
  User
}

model Notification {
  id                 String                  @id // Mongo ObjectId (hex)
  recipientId        String // → users.id (FK добавим в домене identity)
  message            String
  description        String?
  type               NotificationType
  read               Boolean                 @default(false)
  metadataLink       String?
  metadataEntityType NotificationEntityType?
  metadataEntityId   String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([recipientId, read])
  @@map("notifications")
}

// --- Домен 2: Payment (v2 Payment, коллекция payments) ---
// contractId/userId/clubId пока без FK (TrainingContract/User/Club ещё в Mongo).
// Два уникальных ограничения повторяют Mongo: один платёж на контракт + уникальный
// id транзакции шлюза (идемпотентность вебхука Stripe).

enum PaymentGateway {
  Stripe
  PayPal
  Manual
}

enum PaymentStatus {
  pending
  succeeded
  failed
}

model Payment {
  id                   String         @id // Mongo ObjectId (hex)
  clubId               String? // → clubs.id
  userId               String // → users.id
  contractId           String         @unique // один платёж на контракт
  amount               Int // в центах (min 0)
  currency             String // ISO-4217, uppercase (3)
  paymentGateway       PaymentGateway
  gatewayTransactionId String         @unique
  receiptUrl           String?
  status               PaymentStatus
  metadata             Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([userId])
  @@index([clubId])
  @@map("payments")
}

// --- Домен 3: Identity (v2 User == mongoose-модель 'TestUser', коллекция testusers) ---
// Канонические пользователи (решение Никиты: testusers → единая таблица users;
// legacy models/User как сущность НЕ переносим). PK = строка Mongo ObjectId.
// Нормализацию email→lowercase, телефон E.164, хеш пароля (bcrypt) и проверку
// пароля делает репозиторный шов user.repo.js (как раньше Mongoose pre-save/методы).
//
// roles — РЕАЛЬНЫЙ массив: есть фильтры find({roles:'ADMIN'}) и find({roles:role}).
// Рейтинги Glicko-2 по 4 контролям уплощены в 16 КОЛОНОК (не JSON): gameManager
// делает АТОМАРНЫЙ $set/$inc на ratings.{speed}.* после рейтинговой партии —
// колонки + Prisma increment сохраняют атомарность без гонки read-modify-write.
// Шов отдаёт их наружу в прежней форме { ratings: { bullet:{rating,rd,vol,games}, ... } }.

model User {
  id                  String   @id // Mongo ObjectId (hex)
  uuid                String   @unique @default(uuid())
  firebaseUID         String?  @unique // sparse: NULL в Postgres различны — несколько NULL допустимы
  firstName           String
  lastName            String
  avatarUrl           String?
  email               String   @unique // всегда lowercase (нормализует шов)
  phone               String? // E.164 (+380501234567), валидирует шов
  emailVerified       Boolean  @default(false)
  verificationToken   String?
  password            String // bcrypt-хеш
  roles               String[] @default(["USER"])
  sessionTokenVersion Int      @default(0) // ревокация сессий (accessToken.js)

  // Рейтинги онлайн-партий (Glicko-2, v2/utils/ratingCalculator.js) — по контролям
  bulletRating    Float @default(1500)
  bulletRd        Float @default(350)
  bulletVol       Float @default(0.06)
  bulletGames     Int   @default(0)
  blitzRating     Float @default(1500)
  blitzRd         Float @default(350)
  blitzVol        Float @default(0.06)
  blitzGames      Int   @default(0)
  rapidRating     Float @default(1500)
  rapidRd         Float @default(350)
  rapidVol        Float @default(0.06)
  rapidGames      Int   @default(0)
  classicalRating Float @default(1500)
  classicalRd     Float @default(350)
  classicalVol    Float @default(0.06)
  classicalGames  Int   @default(0)

  // Рейтинг решения задач (Elo, v2/utils/puzzleRatingCalculator.js) — Module 4
  puzzleRating      Float @default(1500)
  puzzleRatingGames Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationToken])
  @@index([lastName, firstName]) // список/сортировка студентов (chat, admin)
  @@map("users")
}

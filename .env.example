# Бэкенд школы шахмат. Скопируйте в .env и заполните: cp .env.example .env
# Значения в кавычках не нужны. Файл .env в git не попадает (.gitignore).

# --- Сервер
# Без переменной — 5000; фронтенд по умолчанию ждёт API на 3000 (VITE_API_URL)
PORT=3000
# production — боевая почта (PROD_MAIL_*), development — Mailtrap (MAILTRAP_*)
NODE_ENV=production
# Публичный адрес бэкенда (ссылки подтверждения почты, аватары), без / в конце
BASE_URL=https://api.example.com
# Адрес фронтенда (письма, возврат после оплаты Stripe), без / в конце
FRONTEND_BASE_URL=https://example.com
# Дополнительные разрешённые источники CORS (REST и socket.io) через запятую.
# localhost:5173/3001/3002 и превью Vercel разрешены всегда
CORS_ORIGINS=https://example.com,https://www.example.com

# --- База данных
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/chess-school?retryWrites=true&w=majority

# --- Авторизация
# Длинная случайная строка: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Тот же секрет должен быть в chess-pdf-digitizer/.env (JWT_SECRET)
JWT_SECRET=
# Вход через Google (необязательно)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Микросервис оцифровки PDF (chess-pdf-digitizer)
DIGITIZER_URL=http://localhost:8000

# --- Оплата Stripe (без ключа бэкенд не стартует; для теста — sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Автоперевод профилей тренеров DeepL (необязательно; без ключа перевод отключён)
DEEPL_AUTH_KEY=

# --- Почта: боевая (NODE_ENV=production)
PROD_MAIL_HOST=smtp.example.com
PROD_MAIL_PORT=465
PROD_MAIL_USER=
PROD_MAIL_PASS=

# --- Почта: тестовая Mailtrap (NODE_ENV=development)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=

# Интерактивный класс: медиа-микросервис LiveKit (WebRTC SFU)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880
